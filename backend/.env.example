# Copy to .env for local development. Placeholders only — never commit real
# secrets (plan.md section 12).

ENVIRONMENT=local

# Comma-separated list of allowed CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:3000

# Phase 1 mock-auth signing secret (NOT a Cognito credential). Generate a
# random local value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
MOCK_AUTH_SECRET=changeme-generate-a-random-local-value

# Phase 1 evidence evaluator flag. Keep true until Phase 2 wires up a real
# Amazon Bedrock integration (see app/services/evidence_evaluator.py).
USE_BEDROCK_MOCK=true
