{
  "$schema": "https://openapi.vercel.sh",
  "version": 2,
  "name": "skillgraph-ai",
  "builds": [
    {
      "src": "frontend",
      "use": "@vercel/next@latest"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_USE_MOCKS": "true",
    "NEXT_PUBLIC_API_BASE_URL": "@api_base_url"
  },
  "regions": ["iad1"],
  "functions": {
    "frontend/app/**": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}