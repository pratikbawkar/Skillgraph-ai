# Base URL of the FastAPI backend. Leave unset while USE_MOCKS=true.
NEXT_PUBLIC_API_BASE_URL=

# When true (default), the frontend serves local mock data instead of
# calling the backend/AWS-backed services. Set to false once the FastAPI
# backend is available and NEXT_PUBLIC_API_BASE_URL is configured.
NEXT_PUBLIC_USE_MOCKS=true

# Production admin auth (Amazon Cognito). Set by the CD workflow from Terraform
# outputs; never put a password or secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_COGNITO_REGION=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Mock-only admin gate (used only when NEXT_PUBLIC_API_BASE_URL is empty) for editing recommended videos locally.
# Local mock login only — NEXT_PUBLIC_ values ship in the built JS bundle, and
# this local path is not production authentication. Leave unset to disable admin login.
# Set your own values in a local, gitignored .env.local — never commit real values here.
NEXT_PUBLIC_ADMIN_USERNAME=
NEXT_PUBLIC_ADMIN_PASSWORD=
