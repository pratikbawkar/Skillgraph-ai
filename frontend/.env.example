# Base URL of the FastAPI backend. Leave unset while USE_MOCKS=true.
NEXT_PUBLIC_API_BASE_URL=

# When true (default), the frontend serves local mock data instead of
# calling the backend/AWS-backed services. Set to false once the FastAPI
# backend is available and NEXT_PUBLIC_API_BASE_URL is configured.
NEXT_PUBLIC_USE_MOCKS=true

# Mock-only admin gate (Phase 1) for editing recommended videos locally.
# Not real security — NEXT_PUBLIC_ values ship in the built JS bundle, and
# there is no backend check yet. Leave unset to disable admin login.
# Set your own values in a local, gitignored .env.local — never commit real values here.
NEXT_PUBLIC_ADMIN_USERNAME=
NEXT_PUBLIC_ADMIN_PASSWORD=
