# Root-level ignore rules (plan.md section 12). Frontend has its own
# frontend/.gitignore for Next.js-specific patterns.

.env
.env.*
!.env.example

# Local credentials and secrets
.aws/
.ssh/
credentials
credentials.*
*.credentials
*.secret
*.secrets
id_rsa
id_ed25519
*.pem
*.key

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
*.tfvars
!*.tfvars.example
terraform.tfstate.d/

node_modules/

# Python (backend/)
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
coverage/
coverage.xml
htmlcov/
*.egg-info/
.venv/
venv/

playwright-report/

# Deployment artifacts are created locally or in CI.
build/
# Terraform / local tooling
*.tfvars.json
.terraformrc
terraform.rc

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/